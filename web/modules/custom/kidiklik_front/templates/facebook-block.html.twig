{#
/**
* @file
* Default theme implementation to display a block.
*
* @see template_preprocess_block()
*
* @ingroup themeable
*/
#}
{% set classes = [
    'clear-both',
] %}
{% for rs in content %}
{% if rs.social == 'facebook' %}
<a href="{{ rs.link }}" target="_blank">
<img src="/assets/img/facebook.png" width="100%" target="blank" />
</a>
{% endif %}
{% endfor %}
